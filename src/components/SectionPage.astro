---
import BaseLayout from "../layouts/BaseLayout.astro";
export interface Item { title: string; href?: string; image?: string; imageAlt?: string; }
interface Props { current?: "things" | "notes"; title: string; description: string[]; items: Item[]; kicker?: string; }
const { current, title, description, items, kicker } = Astro.props;
const isExternal = (href?: string) => !!href && /^https?:\/\//.test(href);
// Rows alternate 2 wide cards, then 3 narrow cards (6-column grid).
// A last row with fewer cards than its slots uses wide cards so no column is left empty.
const spans: number[] = [];
for (let i = 0, row = 0; i < items.length; row++) {
	const size = row % 2 === 0 ? 2 : 3;
	const count = Math.min(size, items.length - i);
	const span = count === 3 ? 2 : 3;
	for (let k = 0; k < count; k++) spans.push(span);
	i += count;
}
---
<BaseLayout title={`${title} — itsmepye`} description={description.join(" ")} current={current}>
	<section class="page-intro">
		{kicker && <p class="kicker">{kicker}</p>}
		<h1>{title}</h1>
		<p>{description.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
	</section>

	{items.length > 0 && (
		<ul class="card-grid" aria-label={`${title} 목록`}>
			{items.map((item, i) => (
				<li class={spans[i] === 3 ? "wide" : "narrow"}>
					<a class="card" href={item.href ?? "#"} target={isExternal(item.href) ? "_blank" : undefined} rel={isExternal(item.href) ? "noreferrer" : undefined}>
						<span class="card-image"><img src={item.image ?? "/images/site/card-placeholder.svg"} alt={item.imageAlt ?? ""} loading="lazy" /></span>
						<span class="card-title">{item.title}</span>
					</a>
				</li>
			))}
		</ul>
	)}
</BaseLayout>
<style>
	/* Rows alternate: 2 wide cards, then 3 narrow cards */
	.card-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px; margin: 0 auto; padding: 0; width: min(1100px, 100%); list-style: none; }
	.card-grid li.narrow { grid-column: span 2; }
	.card-grid li.wide { grid-column: span 3; }

	.card { display: flex; flex-direction: column; height: 100%; padding: 12px; color: var(--ink); background: #fff; border: 1px solid var(--line); border-radius: 16px; transition: transform .25s ease, box-shadow .25s ease; }
	.card:hover { transform: translateY(-6px); box-shadow: 0 14px 32px rgba(31, 35, 40, .08); }
	/* Thumbnails: 3:2 (recommended 1200x800) for every card size */
	.card-image { position: relative; display: block; aspect-ratio: 3 / 2; overflow: hidden; border-radius: 10px; background: #f1f1f1; }
	.card-image::after { content: ""; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .07); pointer-events: none; }
	.card-image img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .4s ease; }
	.card:hover .card-image img { transform: scale(1.04); }
	.card-title { padding: 16px 6px 6px; font-size: 20px; font-weight: 700; line-height: 1.35; letter-spacing: -.01em; }

	@media (max-width: 1100px) {
	}
	@media (max-width: 760px) {
		.card-grid { grid-template-columns: 1fr; gap: 16px; }
		.card-grid li.wide, .card-grid li.narrow { grid-column: auto; }
		.card-title { padding-top: 14px; font-size: 18px; }
	}
</style>
