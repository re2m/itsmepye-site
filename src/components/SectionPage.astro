---
import BaseLayout from "../layouts/BaseLayout.astro";
export interface Item { title: string; description?: string; href?: string; image?: string; imageAlt?: string; }
interface Props { current?: "things" | "notes"; title: string; description: string[]; items: Item[]; }
const { current, title, description, items } = Astro.props;
const isExternal = (href?: string) => !!href && /^https?:\/\//.test(href);
---
<BaseLayout title={`${title} — itsmepye`} description={description.join(" ")} current={current}>
	<section class="page-intro">
		<h1>{title}</h1>
		<p>{description.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
	</section>

	{items.length > 0 && (
		<ul class="card-grid" aria-label={`${title} 목록`}>
			{items.map((item) => (
				<li>
					<a class="card" href={item.href ?? "#"} target={isExternal(item.href) ? "_blank" : undefined} rel={isExternal(item.href) ? "noreferrer" : undefined}>
						<span class="card-image"><img src={item.image ?? "/images/site/card-placeholder.svg"} alt={item.imageAlt ?? ""} loading="lazy" /></span>
						<span class="card-body">
							<span class="card-title">{item.title}</span>
							{item.description && <span class="card-desc">{item.description}</span>}
						</span>
					</a>
				</li>
			))}
		</ul>
	)}
</BaseLayout>
<style>
	/* Rows alternate: 2 wide cards, then 3 narrow cards */
	.card-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px; margin: 0 0 200px; padding: 0 155px; list-style: none; }
	.card-grid li { grid-column: span 2; }
	.card-grid li:nth-child(5n + 1), .card-grid li:nth-child(5n + 2) { grid-column: span 3; }

	.card { display: flex; flex-direction: column; height: 100%; padding: 12px; color: #111; background: #fff; border-radius: 16px; transition: transform .25s ease, box-shadow .25s ease; }
	.card:hover { transform: translateY(-6px); box-shadow: 0 12px 32px rgba(180, 255, 246, .18); }
	.card-image { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 10px; background: #f1f1f1; }
	.card-grid li:nth-child(5n + 1) .card-image, .card-grid li:nth-child(5n + 2) .card-image { aspect-ratio: 16 / 9; }
	.card-image::after { content: ""; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .07); pointer-events: none; }
	.card-image img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .4s ease; }
	.card:hover .card-image img { transform: scale(1.04); }
	.card-body { display: flex; flex-direction: column; gap: 8px; padding: 18px 6px 10px; }
	.card-title { font-size: 20px; font-weight: 700; line-height: 1.35; letter-spacing: -.01em; }
	.card-desc { color: #6b6b6b; font-size: 15px; line-height: 1.55; }

	@media (max-width: 1100px) {
		.card-grid { padding: 0 40px; margin-bottom: 120px; }
	}
	@media (max-width: 760px) {
		.card-grid { grid-template-columns: 1fr; gap: 16px; margin-bottom: 48px; padding: 0; }
		.card-grid li, .card-grid li:nth-child(5n + 1), .card-grid li:nth-child(5n + 2) { grid-column: auto; }
		.card-title { font-size: 18px; }
		.card-desc { font-size: 14px; }
	}
</style>
