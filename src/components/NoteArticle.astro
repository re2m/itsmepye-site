---
import BaseLayout from "../layouts/BaseLayout.astro";
interface Props {
	title: string;
	description: string;
	icon: string;
	/** Main color of this note: used for highlights, sub-headings and its card thumbnail. */
	accent: string;
	/** Readable text color on top of the accent color. */
	accentInk: string;
	body: string;
}
const { title, description, icon, accent, accentInk, body } = Astro.props;
---
<BaseLayout title={`${title} — itsmepye`} description={description} current="notes">
	<article class="note" style={`--accent:${accent};--accent-ink:${accentInk}`}>
		<header class="note-head">
			<a class="note-back" href="/notes">← Notes</a>
			<span class="note-icon" aria-hidden="true">{icon}</span>
			<p class="note-kicker">프예 TIP</p>
			<h1>{title}</h1>
			<p class="note-desc">{description}</p>
		</header>
		<div class="note-body" set:html={body} />
		<footer class="note-foot">
			<a href="https://www.instagram.com/itsme_pye/" target="_blank" rel="noreferrer">@itsme_pye 팔로우하고 새로운 TIP 받아보기 →</a>
		</footer>
	</article>
</BaseLayout>
<style>
	.note { max-width: 780px; margin: 0 auto; color: var(--ink); font-size: 17px; line-height: 1.75; }
	.note-head { padding: 48px 0 36px; border-bottom: 1px solid var(--line); }
	.note-back { display: inline-block; margin-bottom: 36px; color: var(--muted); font-size: 15px; }
	.note-back:hover { color: var(--ink); }
	.note-icon { display: block; font-size: 48px; line-height: 1; }
	.note-kicker { display: inline-block; margin: 24px 0 12px; padding: 4px 10px; color: var(--accent-ink); background: var(--accent); border-radius: 6px; font-size: 14px; font-weight: 700; }
	.note-head h1 { margin: 0; color: var(--ink); font-size: 40px; font-weight: 700; line-height: 1.3; letter-spacing: -.02em; }
	.note-desc { margin: 16px 0 0; color: var(--muted); font-size: 18px; }
	.note-foot { margin-top: 64px; padding-top: 28px; border-top: 1px solid var(--line); }
	.note-foot a { color: var(--accent-dark); font-weight: 600; }

	/* Converted Notion content */
	.note-body :global(h2) { margin: 64px 0 16px; color: var(--ink); font-size: 26px; font-weight: 700; line-height: 1.4; scroll-margin-top: 24px; }
	.note-body :global(h3) { display: inline-block; margin: 40px 0 12px; padding: 2px 10px; color: var(--accent-ink); background: var(--accent); border-radius: 6px; font-size: 19px; font-weight: 700; line-height: 1.5; }
	.note-body :global(p) { margin: 0 0 14px; }
	.note-body :global(a) { color: var(--accent-dark); text-decoration: underline; text-underline-offset: 3px; word-break: break-all; }
	.note-body :global(hr) { margin: 48px 0; border: 0; border-top: 1px solid var(--line); }
	.note-body :global(ul), .note-body :global(ol) { margin: 0 0 14px; padding-left: 1.4em; }
	.note-body :global(li) { margin-bottom: 6px; }
	.note-body :global(ul.todo) { padding-left: 0; list-style: none; }
	.note-body :global(.check) { display: inline-block; width: 16px; height: 16px; margin-right: 10px; vertical-align: -2px; border: 1.5px solid var(--accent); border-radius: 3px; }
	.note-body :global(b) { color: var(--ink); font-weight: 700; }
	.note-body :global(mark) { padding: 0 3px; color: var(--accent-ink); background: var(--accent); border-radius: 3px; }
	.note-body :global(.c-gray) { color: var(--muted); }
	.note-body :global(.c-blue) { color: #1F6FD1; }
	.note-body :global(.c-green) { color: #12855B; }
	.note-body :global(figcaption) { margin-top: 8px; color: var(--muted); font-size: 14px; }
	.note-body :global(.table-wrap) { margin: 8px 0 18px; overflow-x: auto; }
	.note-body :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; }
	.note-body :global(th), .note-body :global(td) { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
	.note-body :global(th) { color: var(--ink); background: var(--soft); font-weight: 600; white-space: nowrap; }
	.note-body :global(u) { text-underline-offset: 3px; }
	.note-body :global(code) { padding: 2px 6px; color: var(--accent-dark); background: var(--soft); border-radius: 4px; font-size: .9em; }
	.note-body :global(pre) { margin: 0 0 16px; padding: 16px 18px; overflow-x: auto; background: #1F2328; border: 1px solid #1F2328; border-radius: 10px; }
	.note-body :global(pre code) { padding: 0; color: #e8e8e8; background: none; font-size: 15px; line-height: 1.6; white-space: pre-wrap; }
	.note-body :global(blockquote) { margin: 0 0 16px; padding: 4px 0 4px 18px; border-left: 3px solid var(--accent); color: var(--ink); }
	.note-body :global(figure) { margin: 16px 0 24px; }
	.note-body :global(figure img) { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 10px; background: #fff; }
	.note-body :global(.callout) { display: flex; gap: 12px; margin: 0 0 18px; padding: 18px 20px; background: var(--soft); border: 1px solid var(--line); border-radius: 12px; }
	.note-body :global(.callout-icon) { flex-shrink: 0; font-size: 20px; line-height: 1.6; }
	.note-body :global(.callout-body) { flex: 1; min-width: 0; }
	.note-body :global(.callout-body > :last-child) { margin-bottom: 0; }
	.note-body :global(.toggle) { margin: 0 0 18px; }
	.note-body :global(.toggle summary) { padding: 6px 0; cursor: pointer; font-weight: 600; }
	.note-body :global(.toggle-body) { padding: 10px 0 0 18px; border-left: 2px solid var(--line); }
	.note-body :global(.columns) { display: flex; gap: 16px; margin-bottom: 16px; }
	.note-body :global(.col) { min-width: 0; }
	.note-body :global(.toc ol) { margin: 8px 0 0; padding-left: 1.2em; }
	.note-body :global(.toc a) { color: var(--muted); text-decoration: none; }
	.note-body :global(.toc a:hover) { color: var(--ink); }

	@media (max-width: 760px) {
		.note { font-size: 16px; }
		.note-head h1 { font-size: 28px; }
		.note-body :global(h2) { font-size: 22px; }
		.note-body :global(.columns) { flex-direction: column; }
	}
</style>
