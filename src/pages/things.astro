---
import SectionPage, { type Item } from "../components/SectionPage.astro";
const items: Item[] = [
	{ title: "나만의 목표 시스템 만들기", description: "노트 2권과 펜 2자루로 만들던 목표 시스템을 3분 만에 질문에 답하면서 완성해요.", href: "/things/goal/", image: "/images/site/thumb-goal.webp", imageAlt: "목표 시스템 만들기 앱 시작 화면" },
];
---
<SectionPage current="things" title="Things" description={["작은 불편을 발견하고", "해결하는 실험실"]} items={items} />
