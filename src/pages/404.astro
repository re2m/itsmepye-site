---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="페이지를 찾을 수 없어요 — 프예의 공간" description="요청하신 페이지를 찾을 수 없어요." noindex>
	<section class="nf">
		<img src="/images/site/logo-star.webp" alt="" width="467" height="480" />
		<p class="nf-code">404</p>
		<h1>페이지를 찾을 수 없어요</h1>
		<p class="nf-text">주소가 바뀌었거나 없는 페이지예요.<br />아래에서 다른 곳으로 가 볼까요?</p>
		<div class="nf-actions">
			<a class="btn" href="/">홈으로</a>
			<a class="btn ghost" href="/things">Things</a>
			<a class="btn ghost" href="/notes">Notes</a>
		</div>
	</section>
</BaseLayout>
<style>
	.nf { display: flex; flex-direction: column; align-items: center; padding: 72px 0 24px; text-align: center; }
	.nf img { width: 140px; height: auto; }
	.nf-code { margin: 28px 0 0; color: var(--accent); font-size: 18px; font-weight: 700; letter-spacing: .1em; }
	.nf h1 { margin: 8px 0 14px; font-size: clamp(30px, 4vw, 44px); font-weight: 700; letter-spacing: -.02em; }
	.nf-text { margin: 0 0 32px; color: var(--muted); font-size: 17px; line-height: 1.7; }
	.nf-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
</style>
