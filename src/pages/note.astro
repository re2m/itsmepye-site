---
import SectionPage from "../components/SectionPage.astro";
const items = [
	{ title: "웹사이트 만들기", description: "기획부터 배포까지, 직접 부딪히며 익힌 웹사이트 제작 과정을 정리합니다." },
	{ title: "일하는 방법", description: "마케팅과 기획, 자동화를 더 잘하기 위해 사용한 방법과 도구를 공유합니다." },
	{ title: "가이드북", description: "복잡한 정보를 바로 실행할 수 있도록 차근차근 정리한 실용 가이드입니다." },
	{ title: "다이어리 제작 추천 설문", description: "몇 가지 질문에 답하면 나에게 맞는 판형·내지·제본을 추천해 드립니다.", href: "/note/diary-quiz" },
	{ title: "나만의 다이어리 만드는 방법", description: "판형부터 내지, 제본, 발주까지 직접 만든 다이어리 제작 과정을 정리했습니다.", href: "/notes/tip-diary" },
];
---
<SectionPage current="note" kicker="02 · NOTES & GUIDES" title="NOTE" description="직접 해보고 알게 된 것을 누구나 따라 할 수 있는 정보와 가이드북으로 정리합니다." accent="#f4d94f" sectionTitle="최근 노트" items={items} />
