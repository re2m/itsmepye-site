---
import SectionPage, { type Item } from "../components/SectionPage.astro";
const items: Item[] = [
	{ title: "비개발자를 위한 토스 미니앱 출시 가이드북", href: "/notes/appintoss", image: "/images/thumbs/appintoss.svg", imageAlt: "" },
	{ title: "1시간 만에 360도 회전 3D 요소 만들기", href: "/notes/3dedit", image: "/images/thumbs/3dedit.svg", imageAlt: "" },
	{ title: "클로드로 카카오톡 자동 발송 설정하는 방법", href: "/notes/kakaochat", image: "/images/thumbs/kakaochat.svg", imageAlt: "" },
	{ title: "나만의 다이어리 만드는 방법", href: "/notes/tip-diary", image: "/images/thumbs/diary.svg", imageAlt: "" },
];
---
<SectionPage current="notes" title="Notes" description={["누구나 호기심을", "쓸모있는 것으로 만들 수 있는 도구"]} items={items} />
