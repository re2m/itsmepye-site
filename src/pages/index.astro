---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout current="home">
	<div class="home">
		<section class="hero">
			<div class="profile-photo hero-photo"><img src="/images/site/profile.webp" alt="프예 사진" width="1200" height="1600" /></div>
			<h1 class="hero-logo"><img src="/images/site/logo.svg" alt="Its me Pye" width="508.746" height="772.457" /></h1>
		</section>

		<section class="intro">
			<p class="intro-title"><span>THINK-MAKE-THINGS</span></p>
			<p class="intro-copy">작은 호기심을<br />쓸모 있는 것으로 만듭니다.</p>
		</section>

		<nav class="shapes" aria-label="둘러보기">
			<a class="shape shape-rect" href="/about"><span>Hi, I’m..</span></a>
			<a class="shape shape-circle" href="/things"><img src="/images/site/circle.svg" alt="" width="363.473" height="355" /><span>I made..</span></a>
			<a class="shape shape-triangle" href="/notes"><img src="/images/site/triangle.svg" alt="" width="537.58" height="295.464" /><span>I shared..</span></a>
		</nav>
	</div>
</BaseLayout>
<style>
	.home { display: flex; flex-direction: column; gap: 136px; padding: 50px 0 150px; }

	.hero { display: flex; align-items: center; gap: 90px; }
	.hero-photo { width: 616.833px; flex-shrink: 0; }
	.hero-logo { width: 488.932px; margin: 0; }
	.hero-logo img { width: 100%; height: auto; }

	.intro { height: 369px; padding: 78px 0 0 103px; }
	.intro-title { margin: 0; font-size: 67.05px; line-height: 67.05px; color: #000; }
	.intro-title span { display: inline-block; background: var(--mint); }
	.intro-copy { margin: 22px 0 0; color: var(--white); font-size: 50.473px; font-weight: 500; line-height: 59.65px; }

	.shapes { position: relative; height: 689px; }
	.shape { position: absolute; display: grid; place-items: center; color: #000; font-family: Inter, var(--font); font-size: 35px; line-height: 44px; transition: transform .3s ease; }
	.shape > * { grid-area: 1 / 1; }
	.shape span { position: relative; }
	.shape-rect { left: 165px; top: 34px; width: 458.195px; height: 242.612px; background: var(--mint); transform: rotate(4.46deg); }
	.shape-rect:hover { transform: rotate(-2deg) scale(1.03); }
	.shape-circle { left: 734px; top: 122px; width: 363.473px; }
	.shape-circle img { width: 100%; height: auto; }
	.shape-circle:hover { transform: scale(1.06); }
	.shape-triangle { left: 370px; top: 401px; width: 524px; }
	.shape-triangle img { width: 102.6%; max-width: none; height: auto; margin: -0.85% 0 0 -1.21%; }
	.shape-triangle span { position: absolute; top: 62.85%; left: 50%; transform: translateX(-50%); line-height: 24px; white-space: nowrap; }
	.shape-triangle:hover { transform: translateY(-10px); }

	@media (max-width: 1340px) {
		.hero { gap: 6vw; }
		.hero-photo { width: 46%; }
		.hero-logo { width: 37%; }
		.intro { height: auto; padding: 40px 0 0 7%; }
		.intro-title { font-size: clamp(32px, 5vw, 67.05px); line-height: 1; }
		.intro-copy { font-size: clamp(26px, 3.8vw, 50.473px); line-height: 1.18; }
		.shapes { height: auto; aspect-ratio: 1320 / 689; }
		.shape { font-size: clamp(18px, 2.6vw, 35px); }
		.shape-rect { left: 12.5%; top: 4.9%; width: 34.7%; height: 35.2%; }
		.shape-circle { left: 55.6%; top: 17.7%; width: 27.5%; }
		.shape-triangle { left: 28%; top: 58.2%; width: 39.7%; }
	}
	@media (max-width: 760px) {
		.home { gap: 72px; padding: 36px 0 0; }
		.hero { flex-direction: column; gap: 40px; }
		.hero-photo { width: 74%; align-self: flex-start; }
		.hero-logo { width: 56%; align-self: flex-end; margin-top: -12%; }
		.intro { padding: 0; }
		.intro-title { font-size: 7.4vw; white-space: nowrap; }
		.intro-copy { margin-top: 14px; font-size: 7vw; }
		.shapes { display: flex; flex-direction: column; align-items: center; gap: 36px; aspect-ratio: auto; }
		.shape { position: relative; inset: auto; font-size: 22px; }
		.shape-rect { width: 78%; height: auto; aspect-ratio: 458 / 243; align-self: flex-start; }
		.shape-circle { width: 62%; align-self: flex-end; }
		.shape-triangle { width: 86%; }
	}
</style>
