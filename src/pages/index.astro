---
const sections = [
	{
		number: "01",
		label: "THINGS",
		title: "직접 만든 것들",
		description: "작은 불편을 해결하기 위해 만든 서비스와 앱을 소개합니다.",
		href: "/things",
		accent: "mint",
	},
	{
		number: "02",
		label: "INFO",
		title: "공유하는 정보",
		description: "만들고 배우며 정리한 가이드북과 실용적인 기록을 모았습니다.",
		href: "/info",
		accent: "yellow",
	},
	{
		number: "03",
		label: "WORK",
		title: "프리랜서 포트폴리오",
		description: "브랜드와 서비스를 더 나은 모습으로 만드는 작업을 소개합니다.",
		href: "/work",
		accent: "lavender",
	},
];
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="프예가 직접 만들고, 배우고, 기록하는 공간입니다." />
		<meta name="generator" content={Astro.generator} />
		<title>프예 — 만들고, 배우고, 기록하는 공간</title>
	</head>
	<body>
		<div class="page-shell">
			<header class="site-header">
				<a class="brand" href="/" aria-label="프예 홈">
					<span class="brand-mark">p</span>
					<span>itsmepye</span>
				</a>
				<nav aria-label="주요 메뉴">
					<a href="/things">Things</a>
					<a href="/info">Info</a>
					<a href="/work">Work</a>
				</nav>
			</header>

			<main>
				<section class="hero" aria-labelledby="hero-title">
					<p class="eyebrow"><span></span> PERSONAL INDEX · 2026</p>
					<h1 id="hero-title">작은 호기심을<br /><em>쓸모 있는 것</em>으로.</h1>
					<p class="hero-copy">
						프예가 직접 만들고, 배우고, 기록하는 공간입니다.<br />
						좋아하는 것을 오래 관찰하고, 누군가에게 도움이 되는 형태로 나눕니다.
					</p>
				</section>

				<section class="section-grid" aria-label="사이트 영역">
					{sections.map((section) => (
						<a class={`section-card ${section.accent}`} href={section.href}>
							<div class="card-top">
								<span>{section.number}</span>
								<span class="arrow" aria-hidden="true">↗</span>
							</div>
							<p class="card-label">{section.label}</p>
							<h2>{section.title}</h2>
							<p class="card-description">{section.description}</p>
						</a>
					))}
				</section>
			</main>

			<footer>
				<span>© 2026 pye</span>
				<span>made with curiosity</span>
			</footer>
		</div>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) { background: #f5f3ee; }
	:global(body) {
		margin: 0;
		color: #22221f;
		font-family: "Helvetica Neue", "Apple SD Gothic Neo", Arial, sans-serif;
		-webkit-font-smoothing: antialiased;
	}
	:global(a) { color: inherit; text-decoration: none; }
	.page-shell { width: min(1160px, calc(100% - 48px)); margin: 0 auto; min-height: 100vh; display: flex; flex-direction: column; }
	.site-header { display: flex; justify-content: space-between; align-items: center; padding: 28px 0; border-bottom: 1px solid #d9d6ce; }
	.brand { display: inline-flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 700; letter-spacing: -0.02em; }
	.brand-mark { display: grid; width: 28px; height: 28px; place-items: center; border-radius: 50%; background: #22221f; color: #f5f3ee; font-family: Georgia, serif; font-size: 18px; font-style: italic; }
	nav { display: flex; gap: 24px; font-size: 13px; color: #6d6b65; }
	nav a { transition: color 180ms ease; }
	nav a:hover { color: #22221f; }
	main { flex: 1; }
	.hero { padding: clamp(82px, 14vw, 160px) 0 88px; }
	.eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 26px; color: #817d73; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; }
	.eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: #fc7057; }
	h1 { max-width: 800px; margin: 0; font-size: clamp(52px, 9vw, 108px); font-weight: 500; line-height: 0.98; letter-spacing: -0.075em; }
	h1 em { color: #fc7057; font-family: Georgia, serif; font-weight: 400; letter-spacing: -0.08em; }
	.hero-copy { margin: 34px 0 0; color: #6d6b65; font-size: 16px; line-height: 1.8; letter-spacing: -0.025em; }
	.section-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; padding-bottom: 90px; }
	.section-card { min-height: 290px; padding: 24px; border-radius: 20px; display: flex; flex-direction: column; transition: transform 180ms ease, box-shadow 180ms ease; }
	.section-card:hover { transform: translateY(-5px); box-shadow: 0 16px 30px rgba(34, 34, 31, 0.1); }
	.mint { background: #c9eadc; }
	.yellow { background: #f6df8b; }
	.lavender { background: #d9d2f2; }
	.card-top { display: flex; justify-content: space-between; color: rgba(34, 34, 31, 0.56); font-size: 12px; font-weight: 700; }
	.arrow { font-size: 22px; line-height: 12px; }
	.card-label { margin: auto 0 12px; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; }
	h2 { margin: 0; font-size: 25px; font-weight: 600; letter-spacing: -0.06em; }
	.card-description { max-width: 240px; margin: 14px 0 0; color: rgba(34, 34, 31, 0.65); font-size: 14px; line-height: 1.6; letter-spacing: -0.025em; }
	footer { display: flex; justify-content: space-between; padding: 24px 0 30px; border-top: 1px solid #d9d6ce; color: #908c83; font-size: 11px; letter-spacing: 0.02em; }
	@media (max-width: 720px) {
		.page-shell { width: min(100% - 32px, 560px); }
		.site-header { padding: 20px 0; }
		nav { gap: 14px; font-size: 12px; }
		.hero { padding: 78px 0 60px; }
		h1 { font-size: clamp(50px, 16vw, 78px); }
		.hero-copy { font-size: 15px; }
		.section-grid { grid-template-columns: 1fr; gap: 12px; padding-bottom: 64px; }
		.section-card { min-height: 220px; }
	}
</style>
