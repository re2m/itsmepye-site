---
import BaseLayout from "../layouts/BaseLayout.astro";
const links = [
	{ label: "릴스 구경하기", href: "https://www.instagram.com/itsme_pye/" },
	{ label: "브런치 글 읽으러 가기", href: "https://brunch.co.kr/@4af4962510ae4a8" },
	// "포트폴리오 확인하기" is hidden until the portfolio page exists (an inert link reads as unfinished).
];
---
<BaseLayout title="About — itsmepye" description="마케터이자 새로운 것을 끊임없이 찾는 다능인, 프예를 소개합니다." current="about">
	<section class="about-hero">
		<div class="about-text">
			<p class="about-kicker">ABOUT</p>
			<h1>안녕하세요,<br />프예입니다</h1>
			<p class="about-lead">마케터이자 새로운 것을 끊임없이 찾는 다능인. 생활 속 작은 문제를 서비스로 만들고, 시행착오에서 얻은 정보를 기록하며, 나의 기준대로 살아가는 방법을 공유합니다.</p>
			<ul class="about-links">
				{links.map((link) => <li><a href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a></li>)}
			</ul>
		</div>
		<div class="about-photo"><img src="/images/site/profile-about.webp" alt="딸기 모자를 쓰고 웃고 있는 프예" width="1080" height="1080" /></div>
	</section>

	<section class="about-cards">
		<a class="about-card" href="/things"><span class="num">01</span><h2>Things</h2><p>작은 불편을 발견하고 해결하는 실험실. 직접 만든 서비스와 도구를 모았어요.</p><span class="more">Things 보기 →</span></a>
		<a class="about-card" href="/notes"><span class="num">02</span><h2>Notes</h2><p>누구나 호기심을 쓸모 있는 것으로 만들 수 있도록, 직접 해보고 정리한 가이드예요.</p><span class="more">Notes 보기 →</span></a>
	</section>
</BaseLayout>
<style>
	.about-hero { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; min-height: 600px; overflow: hidden; color: #fff; background: var(--accent); border-radius: 40px; }
	.about-text { padding: 72px 0 72px 72px; }
	.about-kicker { margin: 0; font-size: 15px; font-weight: 600; letter-spacing: .08em; opacity: .85; }
	.about-hero h1 { margin: 14px 0 22px; font-size: clamp(40px, 5vw, 64px); font-weight: 700; line-height: 1.1; letter-spacing: -.03em; }
	.about-lead { max-width: 480px; margin: 0 0 32px; font-size: 18px; line-height: 1.75; }
	.about-links { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; padding: 0; list-style: none; }
	.about-links a { display: inline-block; padding: 12px 20px; color: var(--ink); background: #fff; border-radius: 999px; font-size: 15px; font-weight: 600; transition: opacity .2s; }
	.about-links a:hover { opacity: .85; }
	.about-photo { padding: 56px 56px 56px 0; }
	.about-photo img { width: 100%; height: auto; max-width: 480px; margin-left: auto; aspect-ratio: 1; object-fit: cover; border-radius: 24px; }

	.about-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; width: min(1100px, 100%); margin: 96px auto 0; }
	.about-card { display: block; padding: 36px 36px 32px; background: var(--soft); border-radius: 20px; transition: background .2s; }
	.about-card:hover { background: #ECEDEF; }
	.num { display: inline-grid; place-items: center; min-width: 36px; height: 28px; padding: 0 8px; color: #fff; background: var(--accent); border-radius: 999px; font-size: 13px; font-weight: 600; }
	.about-card h2 { margin: 16px 0 10px; font-size: 28px; font-weight: 600; }
	.about-card p { margin: 0 0 22px; color: var(--muted); font-size: 15px; line-height: 1.7; }
	.more { color: var(--accent-dark); font-size: 15px; font-weight: 600; }

	@media (max-width: 900px) {
		.about-hero { grid-template-columns: 1fr; min-height: 0; border-radius: 28px; }
		.about-text { padding: 44px 28px 0; }
		.about-lead { font-size: 16px; }
		.about-photo { padding: 32px 28px 28px; }
		.about-photo img { max-width: none; margin: 0; border-radius: 18px; }
		.about-cards { grid-template-columns: 1fr; margin-top: 64px; }
	}
</style>
