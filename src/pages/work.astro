const items = [
	{ title: "Growth", description: "데이터와 사용자 행동을 바탕으로 브랜드와 서비스의 성장을 설계합니다." },
	{ title: "Content", description: "사람의 관심을 행동으로 연결하는 콘텐츠와 캠페인을 기획합니다." },
	{ title: "Product", description: "문제를 정의하고 아이디어를 실제 사용자 경험과 제품으로 구현합니다." },
