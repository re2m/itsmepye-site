---
interface Props {
	title?: string;
	description?: string;
	current?: "home" | "about" | "things" | "notes";
	/** Share preview image (PNG/JPG, 1200x630) path under /public. */
	image?: string;
	/** Open Graph type: "website" for pages, "article" for notes. */
	type?: "website" | "article";
	/** Keep the page out of search results (e.g. 404). */
	noindex?: boolean;
}
const {
	title = "itsmepye — 작은 호기심을 쓸모 있는 것으로",
	description = "프예가 직접 만들고, 배우고, 기록하는 공간입니다.",
	current,
	image = "/images/og/default.png",
	type = "website",
	noindex = false,
} = Astro.props;
// Same form as the live links and the sitemap: no trailing slash except the home page.
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, "") || "/", Astro.site);
const imageUrl = new URL(image, Astro.site);
const nav = [
	{ label: "About", href: "/about", key: "about" },
	{ label: "Things", href: "/things", key: "things" },
	{ label: "Notes", href: "/notes", key: "notes" },
];
const instagram = "https://www.instagram.com/itsme_pye/";
---
<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<!-- Google Tag Manager -->
		<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-MRDKS448');</script>
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="AAizBWO-kCNmlJBW-SiunqGDqYx7mMLrgZ1WsnwPUOs" />
		<meta name="naver-site-verification" content="f25cf8a39d2b4ee229fe1e6476b340b6ba2b9db5" />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta property="og:site_name" content="itsmepye" />
		<meta property="og:locale" content="ko_KR" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" />
		<title>{title}</title>
		<script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8925992207022674" crossorigin="anonymous"></script>
	</head>
	<body>
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MRDKS448" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<header class="site-header">
			<a class="site-logo" href="/" aria-label="itsmepye 홈"><img src="/images/site/logo-star.webp" alt="itsmepye" width="467" height="480" /></a>
			<nav aria-label="주요 메뉴">
				{nav.map((item) => <a href={item.href} aria-current={current === item.key ? "page" : undefined}>{item.label}</a>)}
			</nav>
			<a class="btn header-cta" href={instagram} target="_blank" rel="noreferrer">Instagram ↗</a>
		</header>
		<main class="wrap"><slot /></main>
		<footer class="site-footer wrap">
			<div class="footer-top">
				<a href="/" aria-label="itsmepye 홈"><img src="/images/site/logo-star-white.webp" alt="itsmepye" width="467" height="480" /></a>
				<nav aria-label="하단 메뉴">{nav.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
				<a class="footer-ig" href={instagram} target="_blank" rel="noreferrer" aria-label="Instagram @itsme_pye">
					<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none" /></svg>
				</a>
			</div>
			<div class="footer-bottom">
				<p>Instagram <a href={instagram} target="_blank" rel="noreferrer">@itsme_pye</a> · <a href="mailto:leeyr991229@gmail.com">leeyr991229@gmail.com</a></p>
				<p><a href="/privacy">개인정보처리방침</a></p>
				<p>© 2026 itsmepye</p>
			</div>
		</footer>
	</body>
</html>
<style is:global>
	:root {
		--bg: #FCFCFD;
		--ink: #1F2328;
		--muted: #777E90;
		--line: #E6E8EC;
		--soft: #F4F4F5;
		--accent: #13B5A8;      /* deep mint: buttons, footer, feature cards */
		--accent-dark: #0E8F85;
		--mint: #B4FFF6;        /* brand mint: hero, highlights */
		--white: #fff;
		--font: "Poppins", "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", sans-serif;
	}
	* { box-sizing: border-box; }
	html { background: var(--bg); scroll-behavior: smooth; }
	body { margin: 0; color: var(--ink); background: var(--bg); font-family: var(--font); -webkit-font-smoothing: antialiased; }
	a { color: inherit; text-decoration: none; }
	img { display: block; max-width: 100%; }
	.wrap { width: min(1300px, calc(100% - 48px)); margin-inline: auto; }
	main { min-height: 60vh; }

	.btn { display: inline-flex; align-items: center; gap: 6px; padding: 12px 22px; color: #fff; background: var(--accent); border: 1px solid var(--accent); border-radius: 999px; font: 600 15px/1.2 var(--font); white-space: nowrap; transition: background .2s, border-color .2s; }
	.btn:hover { background: var(--accent-dark); border-color: var(--accent-dark); }
	.btn.ghost { color: var(--ink); background: #fff; border-color: var(--line); }
	.btn.ghost:hover { border-color: var(--ink); }

	/* Header */
	.site-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 96px; padding: 0 32px; }
	.site-logo img { width: auto; height: 52px; }
	.site-header nav { display: flex; gap: 36px; color: var(--muted); font-size: 16px; font-weight: 500; }
	.site-header nav a:hover, .site-header nav a[aria-current="page"] { color: var(--ink); }
	.site-header nav a[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 8px; text-decoration-color: var(--accent); }
	.header-cta { justify-self: end; }

	/* Footer card */
	.site-footer { margin-top: 140px; margin-bottom: 32px; padding: 48px 56px 40px; color: #fff; background: var(--accent); border-radius: 22px; box-shadow: 0 12px 30px rgba(19, 181, 168, .25); }
	.footer-top { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 40px; padding-bottom: 32px; border-bottom: 1px solid rgba(255, 255, 255, .6); }
	.footer-top img { width: auto; height: 80px; }
	.footer-top nav { display: flex; justify-content: center; gap: 40px; font-size: 15px; font-weight: 500; }
	.footer-top nav a:hover { opacity: .75; }
	.footer-ig { display: grid; place-items: center; width: 44px; height: 44px; border: 1.5px solid rgba(255, 255, 255, .7); border-radius: 50%; transition: background .2s, color .2s; }
	.footer-ig:hover { color: var(--accent); background: #fff; }
	.footer-bottom { padding-top: 24px; font-size: 14px; line-height: 1.6; }
	.footer-bottom p { margin: 0 0 10px; }
	.footer-bottom a { text-decoration: underline; text-underline-offset: 3px; }

	/* Shared: section heading */
	.sec-title { margin: 0 0 56px; text-align: center; font-size: clamp(32px, 4vw, 48px); font-weight: 700; line-height: 1.2; letter-spacing: -.03em; }
	.sec-title small { display: block; margin-bottom: 10px; color: var(--accent); font-size: 15px; font-weight: 600; letter-spacing: .08em; }

	/* Shared: page title block (Things / Notes / Privacy) */
	.page-intro { padding: 72px 0 64px; text-align: center; }
	.page-intro .kicker { margin: 0 0 12px; color: var(--accent); font-size: 15px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
	.page-intro h1 { margin: 0; font-size: clamp(44px, 6vw, 72px); font-weight: 700; line-height: 1.1; letter-spacing: -.03em; }
	.page-intro p { margin: 18px 0 0; color: var(--muted); font-size: 18px; line-height: 1.6; }

	/* Shared: masked profile photo (outline of the Figma mask, as a polygon) */
	.profile-photo { position: relative; aspect-ratio: 616.833 / 796; overflow: hidden; clip-path: polygon(40.98% 9.34%, 40.98% 29.75%, 31.76% 35.42%, 27.61% 48.73%, 21.27% 44.53%, 19.07% 36.89%, 7.32% 35.42%, 0.00% 44.53%, 4.44% 56.59%, 15.22% 58.29%, 27.61% 67.17%, 23.51% 82.41%, 31.76% 100.00%, 85.41% 100.00%, 84.78% 93.75%, 90.83% 88.57%, 100.00% 58.29%, 95.27% 36.89%, 81.90% 28.54%, 83.17% 16.48%, 76.83% 4.42%, 61.27% 0.00%); }
	.profile-photo img { position: absolute; left: 4.103%; top: -14.121%; width: 112.823%; max-width: none; height: auto; }

	@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; scroll-behavior: auto !important; } }

	@media (max-width: 900px) {
		.site-header { grid-template-columns: auto 1fr; height: 76px; padding: 0 20px; }
		.site-logo img { height: 42px; }
		.site-header nav { justify-content: flex-end; gap: 20px; font-size: 14px; }
		.header-cta { display: none; }
		.site-footer { margin-top: 96px; padding: 36px 28px; }
		.footer-top { grid-template-columns: 1fr auto; gap: 24px; }
		.footer-top img { height: 64px; }
		.footer-top nav { grid-column: 1 / -1; grid-row: 2; justify-content: flex-start; gap: 24px; }
		.page-intro { padding: 48px 0 40px; }
		.page-intro p { font-size: 16px; }
	}
	@media (max-width: 760px) {
		.wrap { width: calc(100% - 32px); }
	}
</style>
