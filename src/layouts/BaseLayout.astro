---
interface Props { title?: string; description?: string; current?: "home" | "about" | "things" | "notes"; }
const { title = "itsmepye — 작은 호기심을 쓸모 있는 것으로", description = "프예가 직접 만들고, 배우고, 기록하는 공간입니다.", current } = Astro.props;
const nav = [
	{ label: "Home", href: "/", key: "home" },
	{ label: "About", href: "/about", key: "about" },
	{ label: "Things", href: "/things", key: "things" },
	{ label: "Notes", href: "/notes", key: "notes" },
];
const footerNav = nav.slice(1);
---
<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400&display=swap" />
		<title>{title}</title>
	</head>
	<body>
		<div class="site">
			<header class="site-header">
				<nav aria-label="주요 메뉴">
					{nav.map((item) => <a href={item.href} aria-current={current === item.key ? "page" : undefined}>{item.label}</a>)}
				</nav>
			</header>
			<main><slot /></main>
			<footer class="site-footer">
				<div class="footer-brand">
					<a href="/" aria-label="itsmepye 홈"><img src="/images/site/logo-footer.svg" alt="Its me Pye" width="194.591" height="295.459" /></a>
					<p>© 2026 itsmepye</p>
				</div>
				<ul class="footer-nav">
					{footerNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
				</ul>
				<div class="footer-contact">
					<div><p>Instagram</p><a href="https://www.instagram.com/itsme_pye/" target="_blank" rel="noreferrer">@itsme_pye</a></div>
					<div><p>Email</p><a href="mailto:leeyr991229@gmail.com">leeyr991229@gmail.com</a></div>
				</div>
			</footer>
		</div>
	</body>
</html>
<style is:global>
	:root {
		--bg: #000;
		--mint: #b4fff6;
		--lime: #edff69;
		--lilac: #cf95ff;
		--white: #fff;
		--site-width: 1320px;
		--font: "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", sans-serif;
	}
	* { box-sizing: border-box; }
	html { background: var(--bg); scroll-behavior: smooth; }
	body { margin: 0; color: var(--mint); background: var(--bg); font-family: var(--font); -webkit-font-smoothing: antialiased; }
	a { color: inherit; text-decoration: none; }
	img { display: block; max-width: 100%; }
	.site { width: min(var(--site-width), calc(100% - 48px)); margin-inline: auto; }

	/* Header */
	.site-header { display: flex; justify-content: flex-end; height: 178px; padding: 76px 25px 0; }
	.site-header nav { display: flex; align-items: flex-start; gap: 50px; }
	.site-header nav a { width: 118px; padding-bottom: 5px; border-bottom: 1px solid var(--mint); font-size: 19px; line-height: 20px; text-transform: uppercase; transition: opacity .2s ease; }
	.site-header nav a:hover { opacity: .65; }
	.site-header nav a[aria-current="page"] { font-weight: 600; }

	main { min-height: 60vh; }

	/* Footer */
	.site-footer { display: grid; grid-template-columns: 573px 292px 1fr; align-items: start; min-height: 518px; padding: 56px 0 56px 87px; }
	.footer-brand { display: flex; flex-direction: column; gap: 36px; }
	.footer-brand img { width: 187px; height: auto; }
	.footer-brand p { margin: 0; font-size: 15px; line-height: 20px; text-transform: uppercase; }
	.footer-nav { display: flex; flex-direction: column; gap: 50px; margin: 32px 0 0; padding: 0 25px; list-style: none; font-size: 30px; font-weight: 600; line-height: 20px; text-transform: uppercase; }
	.footer-contact { display: flex; flex-direction: column; gap: 50px; margin-top: 175px; }
	.footer-contact div { display: flex; flex-direction: column; gap: 15px; }
	.footer-contact p { margin: 0; font-size: 30px; font-weight: 600; line-height: 20px; text-transform: uppercase; }
	.footer-contact a { font-size: 20px; line-height: 20px; text-decoration: underline; }
	.footer-nav a:hover, .footer-contact a:hover { opacity: .65; }

	/* Shared: masked profile photo */
	.profile-photo { position: relative; aspect-ratio: 616.833 / 796; overflow: hidden; -webkit-mask: url("/images/site/profile-mask.svg") center / 100% 100% no-repeat; mask: url("/images/site/profile-mask.svg") center / 100% 100% no-repeat; }
	.profile-photo img { position: absolute; left: 4.103%; top: -14.121%; width: 112.823%; max-width: none; height: auto; }

	/* Shared: page title block (Things / Notes) */
	.page-intro { display: flex; flex-direction: column; gap: 67px; height: 514px; padding: 123px 0 0 160px; font-weight: 700; text-transform: uppercase; }
	.page-intro h1 { margin: 0; font-size: 100px; line-height: 60px; }
	.page-intro p { margin: 0; font-size: 30px; line-height: 44px; }

	@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; } }

	@media (max-width: 1100px) {
		.site-footer { grid-template-columns: 1fr 1fr; gap: 48px 24px; padding-left: 0; }
		.footer-brand { grid-row: span 2; }
		.footer-contact { margin-top: 0; }
		.page-intro { padding-left: 40px; }
	}
	@media (max-width: 760px) {
		.site { width: calc(100% - 40px); }
		.site-header { height: auto; padding: 28px 0 0; justify-content: stretch; }
		.site-header nav { flex: 1; gap: 14px; }
		.site-header nav a { flex: 1; width: auto; font-size: 14px; }
		.site-footer { grid-template-columns: 1fr 1fr; min-height: 0; padding: 72px 0 48px; }
		.footer-brand { gap: 24px; }
		.footer-brand img { width: 110px; }
		.footer-brand p { font-size: 12px; }
		.footer-nav { gap: 28px; margin-top: 8px; padding: 0; font-size: 20px; }
		.footer-contact { grid-column: 1 / -1; gap: 28px; }
		.footer-contact p { font-size: 20px; }
		.footer-contact a { font-size: 16px; }
		.page-intro { gap: 32px; height: auto; padding: 72px 0 64px; }
		.page-intro h1 { font-size: 56px; line-height: 1; }
		.page-intro p { font-size: 20px; line-height: 1.5; }
	}
</style>
