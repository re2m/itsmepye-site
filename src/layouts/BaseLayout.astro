---
interface Props { title?: string; description?: string; current?: "things" | "note" | "work" | "contact"; }
const { title = "프예 — 만들고, 배우고, 기록하는 공간", description = "프예가 직접 만들고, 배우고, 기록하는 공간입니다.", current } = Astro.props;
const nav = [
	{ label: "things", href: "/things", key: "things" },
	{ label: "note", href: "/note", key: "note" },
	{ label: "work", href: "/work", key: "work" },
	{ label: "contact", href: "/contact", key: "contact" },
];
---
<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/" aria-label="프예 홈">itsme.pye</a>
			<nav aria-label="주요 메뉴">{nav.map((item) => <a href={item.href} aria-current={current === item.key ? "page" : undefined}>{item.label}</a>)}</nav>
		</header>
		<main><slot /></main>
		<footer>
			<div><a class="footer-brand" href="/">itsmepye</a><p>작은 호기심을 쓸모 있는 것으로 만듭니다.</p></div>
			<div class="footer-links">{nav.map((item) => <a href={item.href}>{item.label}</a>)}<a href="https://www.instagram.com/itsme_pye/" rel="noreferrer">instagram ↗</a></div>
			<p class="copyright">© 2026 PYE</p>
		</footer>
	</body>
</html>
<style is:global>
	:root { --ink: #11110f; --paper: #f5f3ee; --line: #d7d3ca; --lime: #c7ff18; --coral: #ff684f; }
	* { box-sizing: border-box; }
	html { background: var(--paper); scroll-behavior: smooth; }
	body { margin: 0; color: var(--ink); font-family: "Helvetica Neue", "Apple SD Gothic Neo", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
	a { color: inherit; text-decoration: none; }
	.site-header { position: sticky; top: 0; z-index: 20; display: flex; align-items: center; justify-content: space-between; min-height: 62px; padding: 0 max(24px, calc((100vw - 1280px) / 2)); color: white; background: var(--ink); border-bottom: 1px solid #ffffff2a; }
	.brand { display: inline-flex; align-items: center; font-size: 15px; font-weight: 800; letter-spacing: -.045em; }
	nav { display: flex; align-items: center; gap: clamp(14px, 3vw, 34px); font-size: 12px; text-transform: lowercase; }
	nav a { color: #ffffffa8; transition: color .18s ease; }
	nav a:hover, nav a[aria-current="page"] { color: var(--lime); }
	main { min-height: 70vh; }
	footer { position: relative; display: grid; grid-template-columns: 1.5fr 1fr auto; gap: 32px; padding: 50px max(24px, calc((100vw - 1280px) / 2)) 30px; background: var(--lime); }
	.footer-brand { font-size: clamp(36px, 6vw, 72px); font-weight: 800; letter-spacing: -.08em; }
	footer p { margin: 10px 0 0; font-size: 13px; }
	.footer-links { display: grid; align-content: start; gap: 8px; font-size: 13px; }
	.copyright { align-self: end; font-size: 10px; letter-spacing: .08em; }
	.container { width: min(1280px, calc(100% - 48px)); margin-inline: auto; }
	.page-hero { position: relative; min-height: 560px; padding: clamp(80px, 11vw, 150px) 0 64px; overflow: hidden; border-bottom: 1px solid var(--line); }
	.page-kicker { margin: 0 0 24px; font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
	.display-title { position: relative; z-index: 1; max-width: 980px; margin: 0; font-size: clamp(66px, 12vw, 164px); font-weight: 600; line-height: .82; letter-spacing: -.09em; }
	.page-description { position: relative; z-index: 1; max-width: 560px; margin: 40px 0 0 auto; font-size: clamp(16px, 2vw, 22px); line-height: 1.6; letter-spacing: -.035em; }
	.hero-orbit { position: absolute; right: -70px; bottom: -155px; width: clamp(300px, 42vw, 620px); aspect-ratio: 1; border: 1px solid #11110f4d; border-radius: 50%; }
	.hero-orbit::before, .hero-orbit::after { content: ""; position: absolute; border-radius: 50%; }
	.hero-orbit::before { inset: 14%; border: 1px solid #11110f4d; }
	.hero-orbit::after { inset: 38%; background: var(--accent, var(--lime)); }
	.content-section { padding: 88px 0 120px; }
	.section-heading { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 36px; padding-bottom: 14px; border-bottom: 1px solid var(--ink); }
	.section-heading h2 { margin: 0; font-size: clamp(30px, 5vw, 64px); letter-spacing: -.065em; }
	.section-heading span { padding-top: 12px; font-size: 11px; }
	.item-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
	.item-card { display: flex; flex-direction: column; min-height: 330px; padding: 22px; border: 1px solid var(--line); background: #fbfaf7; transition: transform .2s ease, background .2s ease; }
	.item-card:hover { transform: translateY(-5px); background: white; }
	.item-card .index { font-size: 11px; color: #77736b; }
	.item-card h3 { margin: auto 0 12px; font-size: 29px; letter-spacing: -.06em; }
	.item-card p { max-width: 31ch; margin: 0; color: #66635d; font-size: 14px; line-height: 1.65; }
	.item-card .arrow { align-self: flex-end; margin-top: 25px; font-size: 24px; }
	@media (max-width: 760px) {
		.site-header { min-height: 56px; padding-inline: 16px; }
		.brand { font-size: 13px; }
		nav { gap: 12px; font-size: 11px; }
		.container { width: min(100% - 32px, 620px); }
		.page-hero { min-height: 510px; padding-top: 88px; }
		.display-title { font-size: clamp(64px, 23vw, 106px); }
		.page-description { margin: 46px 0 0; font-size: 16px; }
		.hero-orbit { right: -130px; bottom: -80px; opacity: .75; }
		.content-section { padding: 64px 0 80px; }
		.item-grid { grid-template-columns: 1fr; }
		.item-card { min-height: 240px; }
		footer { grid-template-columns: 1fr 1fr; padding-inline: 16px; }
		.copyright { grid-column: 1 / -1; }
	}
</style>
