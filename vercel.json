{
	"redirects": [
		{
			"source": "/ricecake",
			"destination": "/things/ricecake/",
			"permanent": true
		},
		{
			"source": "/ricecake/(.*)",
			"destination": "/things/ricecake/$1",
			"permanent": true
		},
		{
			"source": "/note",
			"destination": "/notes",
			"permanent": true
		},
		{
			"source": "/contact",
			"destination": "/about",
			"permanent": true
		},
		{
			"source": "/work",
			"destination": "/about",
			"permanent": false
		}
	],
	"functions": {
		"api/notion/create.js": {
			"maxDuration": 60
		}
	},
	"headers": [
		{
			"source": "/private",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow"
				},
				{
					"key": "Cache-Control",
					"value": "private, no-store"
				}
			]
		},
		{
			"source": "/private/(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow"
				},
				{
					"key": "Cache-Control",
					"value": "private, no-store"
				}
			]
		}
	]
}
